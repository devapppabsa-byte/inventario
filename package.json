{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "sass resources/sass/app.scss public/css/app.css --load-path=node_modules --no-source-map",
        "watch": "sass --watch resources/sass/app.scss public/css/app.css --load-path=node_modules --no-source-map",
        "prod": "npm run production",
        "production": "sass resources/sass/app.scss public/css/app.css --load-path=node_modules --no-source-map --style=compressed"
    },
    "devDependencies": {
        "axios": "^0.21",
        "bootstrap": "^5.3.3",
        "jquery": "^3.6",
        "laravel-mix": "^6.0.6",
        "lodash": "^4.17.19",
        "popper.js": "^1.16.1",
        "postcss": "^8.1.14",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.32.11",
        "sass-loader": "^11.0.1",
        "yargs": "^17.6.2"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^5.15.3"
    }
}